{
  "name": "tonematch",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Jewellery metal & style advisor with on-device skin-tone analysis",
  "contributors": [
    {
      "name": "Fabian Haxhiaj",
      "email": "187953086+FabianHaxhiaj22@users.noreply.github.com",
      "url": "https://github.com/FabianHaxhiaj22"
    },
    {
      "name": "Erdiona Tola",
      "email": "353759092+tolaerdiona-commits@users.noreply.github.com",
      "url": "https://github.com/tolaerdiona-commits"
    }
  ],
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "pnpm models:fetch && next dev",
    "build": "pnpm models:fetch && next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "validate:data": "tsx scripts/validate-data.ts",
    "models:fetch": "tsx scripts/fetch-models.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.2.2",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@playwright/test": "1.65.0",
    "@tailwindcss/turbopack": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/culori": "4.0.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "culori": "4.0.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "husky": "9.1.7",
    "jpeg-js": "0.4.4",
    "jsdom": "31.0.0",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
